{
    "manufacturer": "waveshare",
    "type": "esp32-s3-audio-board",
    "target": "esp32s3",
    "builds": [
        {
            "name": "esp32-s3-audio-board",
            "sdkconfig_append": [
                "CONFIG_USE_WECHAT_MESSAGE_STYLE=y",
                "CONFIG_CAMERA_OV2640=y",
                "CONFIG_CAMERA_OV2640_AUTO_DETECT_DVP_INTERFACE_SENSOR=y",
                "CONFIG_CAMERA_OV2640_DVP_YUV422_640X480_6FPS=y",
                "CONFIG_CAMERA_OV2640_DVP_IF_FORMAT_INDEX_DEFAULT=1",
                "CONFIG_CAMERA_OV5640=y",
                "CONFIG_CAMERA_OV5640_AUTO_DETECT_DVP_INTERFACE_SENSOR=y",
                "CONFIG_CAMERA_OV5640_DVP_YUV422_800X600_10FPS=y",
                "CONFIG_CAMERA_OV5640_DVP_IF_FORMAT_INDEX_DEFAULT=0"
            ]
        },
        {
            "name": "esp32-s3-audio-board-ankong",
            "sdkconfig_append": [
                "CONFIG_USE_CUSTOM_WAKE_WORD=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v1/16m_custom_wakeword.csv\"",
                "CONFIG_SR_MN_CN_MULTINET7_QUANT=y",
                "CONFIG_SEND_WAKE_WORD_DATA=y",
                "CONFIG_CUSTOM_WAKE_WORD=\"ni hao an kong yun:你好安控云;an kong yun:安控云;ni hao an xin ju:你好安心居;an xin ju:安心居\"",
                "CONFIG_CUSTOM_WAKE_WORD_DISPLAY=\"你好安控云\"",
                "CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=10",
                "CONFIG_ANKONG_KEEP_CONNECTION=y"
            ]
        }
    ]
}